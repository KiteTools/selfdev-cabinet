# Server only. npm run setup generates secrets; fill in YOUR accounts.
# Never put secrets in assets/ or commit .env.
CABINET_TRANSPORT=local
DATABASE_URL=
# NETLIFY_DATABASE_URL is also supported. Use Neon-compatible PostgreSQL.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
JWT_SECRET=
TELEGRAM_AUTH_MAX_AGE_SECONDS=900
BOT_TIMEZONE=UTC

# Required only when CABINET_TRANSPORT=sendpulse.
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
SENDPULSE_BOT_ID=
# Server-to-server ingestion secrets (not browser credentials).
LK_SERVICE_SECRET=
SENDPULSE_DIARY_SECRET=

# Optional AI: private text is sent only when the user requests these features.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=

# Optional email. MAIL_BCC deliberately empty and not required.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_REPLY_TO=
MAIL_BCC=
