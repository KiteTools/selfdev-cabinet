{
  "name": "selfdev-cabinet",
  "version": "1.0.0",
  "description": "Личный кабинет клиента — Telegram + SendPulse",
  "private": true,
  "scripts": {
    "cli": "node cli/index.mjs",
    "cli:smoke": "node cli/index.mjs smoke full",
    "test:cli": "node --test cli/test/*.test.mjs",
    "test": "node --test tests/*.test.mjs cli/test/*.test.mjs",
    "build": "node scripts/build.mjs",
    "check:env": "node --env-file-if-exists=.env scripts/check-env.mjs",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@netlify/neon": "^0.1.0",
    "busboy": "^1.6.0",
    "jose": "^6.0.0",
    "nodemailer": "^6.9.13"
  },
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  },
  "license": "MIT"
}
